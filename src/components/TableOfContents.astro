---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  defaultOpen?: boolean;
}

const { headings, defaultOpen = true } = Astro.props;
---

{
  headings.length > 0 && (
    <details open={defaultOpen}>
      <summary class="toc-summary">
        <span>on this page</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="10"
          height="10"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="toc-chevron"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <nav aria-label="Table of contents">
        <ul class="mt-3 space-y-2.5" role="list">
          {headings.map((heading) => (
            <li role="listitem">
              <a
                href={`#${heading.slug}`}
                class:list={["toc-link", heading.depth === 3 && "pl-3"]}
                data-heading={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}

<script>
  let cleanup: (() => void) | null = null;

  function initTOC() {
    if (cleanup) cleanup();

    const tocLinks =
      document.querySelectorAll<HTMLAnchorElement>("[data-heading]");
    if (!tocLinks.length) return;

    const headingEls = Array.from(tocLinks)
      .map((link) => document.getElementById(link.dataset.heading || ""))
      .filter(Boolean) as HTMLElement[];

    if (!headingEls.length) return;

    function setActive(id: string) {
      tocLinks.forEach((link) => {
        const isActive = link.dataset.heading === id;
        link.classList.toggle("toc-active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        }
      },
      { rootMargin: "0px 0px -80% 0px", threshold: 0 },
    );

    headingEls.forEach((el) => observer.observe(el));
    cleanup = () => observer.disconnect();
  }

  document.addEventListener("astro:page-load", initTOC);
  document.addEventListener("astro:before-swap", () => {
    if (cleanup) {
      cleanup();
      cleanup = null;
    }
  });
</script>
