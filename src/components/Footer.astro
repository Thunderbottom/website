---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE, SOCIALS } from "@lib/config";
import { FEATURES } from "@site";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Site footer">
  <Container>
    <div class="footer-inner">
      <nav aria-label="Contact and feeds">
        {
          SOCIALS.map((social) => (
            <Link
              href={social.href}
              aria-label={`${SITE.NAME} on ${social.name}`}
              external={!social.href.startsWith("mailto:")}
            >
              {social.name}
            </Link>
          ))
        }
        {FEATURES.resume && <Link href="/resume">Resume</Link>}
        {FEATURES.blog && <Link href="/rss.xml">RSS</Link>}
      </nav>

      <div class="colophon">
        <p>&copy; {currentYear} {SITE.NAME}</p>
        <p>
          Set in Source Serif 4, Atkinson Hyperlegible Next, and Commit Mono.<br>
          Built with Astro.
        </p>
      </div>
    </div>
  </Container>
</footer>
