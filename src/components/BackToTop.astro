---
import IconChevronLeft from "@assets/icons/IconChevronLeft.astro";

interface Props {
  /** Draw reading progress round the button (long reads only). */
  progress?: boolean;
}

const { progress = false } = Astro.props;
---

<button id="back-to-top" type="button" class="to-top" data-visible="false">
  {
    progress && (
      <svg class="to-top-ring" aria-hidden="true">
        <rect x="0" y="0" width="100%" height="100%" pathLength="1" />
      </svg>
    )
  }
  <IconChevronLeft class="up" />
  <span>Back to Top</span>
</button>

<script>
  // Appears once you are past the first screen. On posts its outline doubles as the
  // reading progress: the accent stroke runs clockwise round the button as
  // you scroll, so it works the same on every browser and screen size.
  const button = document.getElementById("back-to-top");
  const ring = button?.querySelector<SVGRectElement>(".to-top-ring rect");

  if (button) {
    let ticking = false;

    const update = () => {
      const root = document.documentElement;
      const y = window.scrollY;
      // Measured from the layout viewport, which does not change when a
      // phone's address bar collapses; the result is clamped so rubber-band
      // overscroll can't push it backwards.
      const max = Math.max(1, root.scrollHeight - root.clientHeight);
      const progress = Math.min(1, Math.max(0, y / max));

      button.dataset.visible = String(y >= 400);
      if (ring) ring.style.strokeDashoffset = String(1 - progress);
      ticking = false;
    };

    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request, { passive: true });
    update();

    button.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" }),
    );
  }
</script>
