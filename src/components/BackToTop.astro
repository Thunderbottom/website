---
import IconChevronLeft from "@assets/icons/IconChevronLeft.astro";
---

<button id="back-to-top" type="button" class="to-top" data-visible="false">
  <IconChevronLeft class="up" />
  <span>Back to Top</span>
</button>

<script>
  // Shown only when you scroll up past the first screen: that is the moment
  // you want to go back to the top, and the rest of the time it would sit on
  // top of what you are reading.
  const button = document.getElementById("back-to-top");

  if (button) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const delta = y - lastY;
      if (y < 400) button.dataset.visible = "false";
      else if (delta < -8) button.dataset.visible = "true";
      else if (delta > 8) button.dataset.visible = "false";
      if (Math.abs(delta) > 8) lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );

    button.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" }),
    );
  }
</script>
