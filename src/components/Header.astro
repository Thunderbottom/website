---
import Container from "@components/Container.astro";
import IconSun from "@assets/icons/IconSun.svg";
import IconMoon from "@assets/icons/IconMoon.svg";
import { NAVIGATION, SITE } from "@lib/config";

const currentPath = Astro.url.pathname;
const isActive = (url: string) =>
  url === "/" ? currentPath === "/" : currentPath === url || currentPath.startsWith(url + "/");
---

<header>
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-y-2">
      <a
        href="/"
        class="text-primary font-bold font-display text-base sm:text-lg transition-colors duration-150 hover:text-text-secondary dark:hover:text-text-secondary-dark"
      >
        {SITE.DOMAIN}
      </a>

      <div class="flex items-center gap-2 sm:gap-3 text-sm md:text-base">
        <nav class="flex items-center gap-1" aria-label="Main navigation">
          {
            NAVIGATION.map((item, index) => (
              <>
                <a
                  href={item.url}
                  aria-current={isActive(item.url) ? "page" : undefined}
                  class="whitespace-nowrap font-mono transition-colors duration-150 text-primary py-1 px-1 sm:px-1.5"
                >
                  {item.name.toLowerCase()}
                </a>
                {index < NAVIGATION.length - 1 && (
                  <span class="hidden sm:inline mx-1 text-text-muted dark:text-text-muted-dark" aria-hidden="true">/</span>
                )}
              </>
            ))
          }
        </nav>

        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle theme"
          class="relative flex h-11 w-11 items-center justify-center transition-colors duration-150"
        >
          <IconSun
            class="absolute size-4 rotate-0 scale-100 transition-transform duration-300 dark:-rotate-90 dark:scale-0"
          />
          <IconMoon
            class="absolute size-4 rotate-90 scale-0 transition-transform duration-300 dark:rotate-0 dark:scale-100"
          />
        </button>
      </div>
    </div>
  </Container>
</header>
