---
import Container from "@components/Container.astro";
import IconSun from "@assets/icons/IconSun.svg";
import IconMoon from "@assets/icons/IconMoon.svg";
import { NAVIGATION, SITE } from "@lib/config";

const currentPath = Astro.url.pathname;
const isActive = (item: { url: string; match?: string[] }) =>
  (item.match ?? [item.url]).some(
    (prefix) => currentPath === prefix || currentPath.startsWith(prefix + "/"),
  );
---

<header class="site-header">
  <Container>
    <div class="row">
      <a href="/" class="site-brand" translate="no">{SITE.DOMAIN}</a>

      <nav class="site-nav" aria-label="Main navigation">
        {
          NAVIGATION.map((item) => (
            <a
              href={item.url}
              aria-current={isActive(item) ? "page" : undefined}
            >
              {item.name}
            </a>
          ))
        }
      </nav>

      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Dark theme"
      >
        <IconSun class="sun" aria-hidden="true" />
        <IconMoon class="moon" aria-hidden="true" />
      </button>
    </div>
  </Container>
</header>
