---
import { formatDate } from "@lib/config";
import Link from "@components/Link.astro";
import type { ProjectItem } from "@lib/projects";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const primaryUrl = project.websiteURL || project.repoURL || project.demoURL;
const links = [
  project.demoURL && { label: "demo", href: project.demoURL },
  project.repoURL && { label: "source", href: project.repoURL },
  project.websiteURL && { label: "website", href: project.websiteURL },
].filter(Boolean) as { label: string; href: string }[];
---

<div class="log-row">
  <time class="log-date" datetime={new Date(project.date).toISOString()}>
    {formatDate(project.date, "%Y-%m-%d")}
  </time>
  <div>
    <span class="log-title">
      {
        primaryUrl ? (
          <a
            href={primaryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            {project.title}
          </a>
        ) : (
          project.title
        )
      }
    </span>
    <p class="log-desc full">{project.description}</p>
    {
      project.tags && project.tags.length > 0 && (
        <span class="log-tags log-tags-boxed">
          {project.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </span>
      )
    }
    {
      links.length > 0 && (
        <nav class="project-links" aria-label={`Links for ${project.title}`}>
          {links.map((item) => (
            <>
              <Link href={item.href} external underline>
                {item.label}
              </Link>
            </>
          ))}
        </nav>
      )
    }
  </div>
</div>
