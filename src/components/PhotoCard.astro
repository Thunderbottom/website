---
import type { ProcessedPhoto } from "@lib/photo-utils";
import Tag from "@components/Tag.astro";
import { escapeHtml } from "@lib/utils";

interface Props {
  photo: ProcessedPhoto;
  loading?: "lazy" | "eager";
}

const { photo, loading = "lazy" } = Astro.props;
const { data, images, exifItems, formattedDate } = photo;
---

<button
  type="button"
  class="card group flex w-full flex-col overflow-hidden text-left"
  data-photo-trigger
  data-full-image={images.lightboxImage.src}
  data-title={escapeHtml(data.title)}
  data-content={escapeHtml(photo.body || "")}
  aria-haspopup="dialog"
  aria-label={`View photo: ${data.title}`}
>
  <div class="relative cursor-pointer">
    <img
      src={images.thumbnailImage.src}
      alt={data.alt || data.title}
      width={images.thumbnailImage.attributes.width}
      height={images.thumbnailImage.attributes.height}
      class="img-loading h-auto w-full object-contain transition-transform duration-300"
      loading={loading}
      decoding="async"
      onload="this.classList.remove('img-loading')"
      onerror="this.classList.remove('img-loading')"
    />

    <div
      class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-200 group-hover:bg-black/15"
    >
      <div
        class="text-white opacity-0 drop-shadow transition-opacity duration-200 group-hover:opacity-100"
        aria-hidden="true"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="card-content">
    <div class="content-flex">
      <div class="mb-2 flex items-start justify-between gap-4">
        <div class="heading-lg">
          {data.title}
        </div>
        <time
          datetime={new Date(data.date).toISOString()}
          class="text-secondary-color font-mono text-xs whitespace-nowrap"
        >
          {formattedDate}
        </time>
      </div>

      {
        exifItems.length > 0 && (
          <div class="flex flex-wrap justify-center gap-1 text-xs">
            {exifItems.map((item) => (
              <Tag text={item} centered />
            ))}
          </div>
        )
      }
    </div>
  </div>
</button>
