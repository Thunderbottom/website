---
import type { ProcessedPhoto } from "@lib/photo-utils";
import { photoHref } from "@lib/photo-utils";

interface Props {
  photo: ProcessedPhoto;
  loading?: "lazy" | "eager";
}

const { photo, loading = "lazy" } = Astro.props;
const { width, height } = photo.images.thumbnailImage.attributes;
const ar = (Number(width) / Number(height)).toFixed(3);
---

<div role="listitem" style={`--ar:${ar}`}>
  <a class="photo-card" href={photoHref(photo)}>
    <img
      src={photo.images.thumbnailImage.src}
      alt={photo.data.alt || photo.data.title}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
    />
    <span class="photo-title">{photo.data.title}</span>
  </a>
</div>
