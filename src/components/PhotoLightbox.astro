---
import IconChevronLeft from "@assets/icons/IconChevronLeft.astro";

// The photo page, shown in an overlay. Every photo card is a real link to
// /photography/<slug>/; this layer only intercepts the click, fetches that
// page, and shows its .photo-page here, so the URL is always shareable and
// the page works without JavaScript.
---

<dialog id="lightbox" aria-label="Photo">
  <button type="button" class="lightbox-close" data-lightbox-close>
    Close <kbd>Esc</kbd>
  </button>
  <div class="lightbox-body"></div>
  <button
    type="button"
    class="lightbox-step prev"
    data-lightbox-step="prev"
    aria-label="Newer photo"
    hidden
  >
    <IconChevronLeft />
  </button>
  <button
    type="button"
    class="lightbox-step next"
    data-lightbox-step="next"
    aria-label="Older photo"
    hidden
  >
    <IconChevronLeft />
  </button>
</dialog>

<script>
  const dialog = document.getElementById(
    "lightbox",
  ) as HTMLDialogElement | null;
  const body = dialog?.querySelector<HTMLElement>(".lightbox-body");

  if (dialog && body) {
    const galleryTitle = document.title;
    // Photo pages are /photography/<slug>/. Filter pages have two segments.
    const isPhotoPath = (path: string) =>
      /^\/photography\/[^/]+\/?$/.test(path);

    interface Loaded {
      html: string;
      title: string;
      image?: string;
    }
    const cache = new Map<string, Promise<Loaded | null>>();

    function load(path: string): Promise<Loaded | null> {
      let hit = cache.get(path);
      if (!hit) {
        hit = fetch(path)
          .then((res) => (res.ok ? res.text() : Promise.reject()))
          .then((text) => {
            const doc = new DOMParser().parseFromString(text, "text/html");
            const page = doc.querySelector(".photo-page");
            if (!page) return null;
            return {
              html: page.outerHTML,
              title: doc.title,
              image:
                page.querySelector(".photo-stage img")?.getAttribute("src") ??
                undefined,
            };
          })
          .catch(() => null);
        cache.set(path, hit);
      }
      return hit;
    }

    // Warm the neighbours so stepping through photos is instant.
    function prefetch(root: ParentNode) {
      root.querySelectorAll<HTMLAnchorElement>(".photo-nav a").forEach((a) => {
        load(new URL(a.href).pathname).then((data) => {
          if (data?.image) new Image().src = data.image;
        });
      });
    }

    async function show(path: string, history_: "push" | "replace" | "none") {
      const data = await load(path);
      if (!data) {
        location.href = path;
        return;
      }
      body!.innerHTML = data.html;
      document.title = data.title;
      if (!dialog!.open) dialog!.showModal();
      if (history_ === "push") history.pushState({ lightbox: true }, "", path);
      else if (history_ === "replace")
        history.replaceState({ lightbox: true }, "", path);
      body!.querySelector(".photo-info")?.scrollTo(0, 0);
      syncSteps();
      prefetch(body!);
    }

    const stepLink = (rel: string) =>
      body!.querySelector<HTMLAnchorElement>(`.photo-nav [rel="${rel}"]`);

    // The edge arrows only exist where there is a photo to go to.
    function syncSteps() {
      dialog!
        .querySelectorAll<HTMLElement>("[data-lightbox-step]")
        .forEach((btn) => {
          btn.hidden = !stepLink(btn.dataset.lightboxStep!);
        });
    }

    function hide() {
      if (dialog!.open) dialog!.close();
      body!.innerHTML = "";
      document.title = galleryTitle;
    }

    // Closing steps back in history, so the gallery URL returns and the
    // browser's own back button does the same thing.
    function close() {
      if (history.state?.lightbox) history.back();
      else hide();
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const plain =
        e.button === 0 && !(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey);

      const card = target.closest<HTMLAnchorElement>("a.photo-card");
      if (card && plain && isPhotoPath(new URL(card.href).pathname)) {
        e.preventDefault();
        show(new URL(card.href).pathname, "push");
        return;
      }

      const step = target.closest<HTMLAnchorElement>("#lightbox .photo-nav a");
      if (step && plain) {
        e.preventDefault();
        show(new URL(step.href).pathname, "replace");
        return;
      }

      const arrow = target.closest<HTMLElement>("[data-lightbox-step]");
      if (arrow) {
        stepLink(arrow.dataset.lightboxStep!)?.click();
        return;
      }

      if (target.closest("[data-lightbox-close]")) close();
    });

    dialog.addEventListener("cancel", (e) => {
      e.preventDefault();
      close();
    });

    document.addEventListener("keydown", (e) => {
      if (!dialog.open || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey)
        return;
      if (e.key === "ArrowLeft") stepLink("prev")?.click();
      else if (e.key === "ArrowRight") stepLink("next")?.click();
    });

    // Swipe: a mostly-horizontal flick on the photo steps to the neighbour,
    // like turning a page. The gallery runs newest to oldest, left to right,
    // so the next photo (older) is to the right and a flick left brings it in.
    let touch: { x: number; y: number } | null = null;
    dialog.addEventListener(
      "touchstart",
      (e) => {
        const t = e.touches[0];
        touch =
          e.touches.length === 1 &&
          (e.target as HTMLElement).closest(".photo-stage, .lightbox-step")
            ? { x: t.clientX, y: t.clientY }
            : null;
      },
      { passive: true },
    );
    dialog.addEventListener(
      "touchend",
      (e) => {
        if (!touch) return;
        const t = e.changedTouches[0];
        const dx = t.clientX - touch.x;
        const dy = t.clientY - touch.y;
        touch = null;
        if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        stepLink(dx < 0 ? "next" : "prev")?.click();
      },
      { passive: true },
    );

    addEventListener("popstate", () => {
      if (isPhotoPath(location.pathname)) show(location.pathname, "none");
      else hide();
    });
  }
</script>
