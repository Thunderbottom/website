---

---

<div
  id="photo-lightbox"
  class="fixed inset-0 z-[100] opacity-0 pointer-events-none"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-title"
  aria-describedby="lightbox-content"
>
  <!-- Close button -->
  <button
    id="lightbox-close"
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center text-white/70 transition-colors duration-150 hover:text-white focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white"
    aria-label="Close photo viewer"
    type="button"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M18 6L6 18M6 6l12 12"></path>
    </svg>
  </button>

  <!-- Counter -->
  <div
    id="lightbox-counter"
    class="absolute left-4 top-4 z-10 font-mono text-xs text-white/50"
    aria-live="polite"
  >
  </div>

  <!-- Navigation -->
  <button
    id="lightbox-prev"
    class="absolute left-2 top-1/2 z-10 hidden h-12 w-11 -translate-y-1/2 items-center justify-center text-white/60 transition-colors duration-150 hover:text-white focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white"
    aria-label="Previous photo"
    type="button"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <button
    id="lightbox-next"
    class="absolute right-2 top-1/2 z-10 hidden h-12 w-11 -translate-y-1/2 items-center justify-center text-white/60 transition-colors duration-150 hover:text-white focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white"
    aria-label="Next photo"
    type="button"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  <!-- Image area -->
  <div class="absolute inset-0 flex items-center justify-center p-4 pb-28">
    <img
      id="lightbox-image"
      src=""
      alt=""
      class="max-h-full max-w-full object-contain opacity-0 transition-opacity duration-200 ease-out"
      style="image-orientation: from-image; width: auto; height: auto;"
    />

    <!-- Loading indicator -->
    <div
      id="lightbox-loading"
      class="absolute hidden items-center gap-1.5"
      aria-live="polite"
      aria-label="Loading photo"
    >
      <span class="block h-1 w-1 animate-pulse bg-white/60" style="animation-delay: 0ms"></span>
      <span class="block h-1 w-1 animate-pulse bg-white/60" style="animation-delay: 150ms"></span>
      <span class="block h-1 w-1 animate-pulse bg-white/60" style="animation-delay: 300ms"></span>
      <span class="sr-only">Loading photo...</span>
    </div>
  </div>

  <!-- Info panel -->
  <div id="lightbox-info" class="absolute bottom-0 left-0 right-0 px-6 py-5">
    <div class="mx-auto max-w-2xl">
      <h2
        id="lightbox-title"
        class="font-display text-base font-semibold text-white"
      >
      </h2>
      <div id="lightbox-content" class="mt-1 font-mono text-xs leading-relaxed text-white/65">
      </div>
    </div>
  </div>
</div>

<script>
  class StaticPhotoLightbox {
    constructor() {
      this.elements = this.getElements();
      this.state = {
        currentPhotoIndex: 0,
        isOpen: false,
      };
      this.triggerElement = null;

      this.boundHandlers = {
        documentClick: this.handleDocumentClick.bind(this),
        documentKeydown: this.handleDocumentKeydown.bind(this),
        backdropClick: this.handleBackdropClick.bind(this),
        close: this.closeLightbox.bind(this),
        prev: this.goToPrevPhoto.bind(this),
        next: this.goToNextPhoto.bind(this),
        trapFocus: this.handleFocusTrap.bind(this),
        touchStart: this.handleTouchStart.bind(this),
        touchEnd: this.handleTouchEnd.bind(this),
      };

      this.touchStartX = 0;
      this.touchStartY = 0;

      if (this.elements.isValid) {
        this.initialize();
      }
    }

    getElements() {
      const lightbox = document.getElementById("photo-lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxTitle = document.getElementById("lightbox-title");
      const lightboxContent = document.getElementById("lightbox-content");
      const lightboxLoading = document.getElementById("lightbox-loading");
      const lightboxCounter = document.getElementById("lightbox-counter");
      const closeButton = document.getElementById("lightbox-close");
      const prevButton = document.getElementById("lightbox-prev");
      const nextButton = document.getElementById("lightbox-next");

      const isValid =
        lightbox &&
        lightboxImage &&
        lightboxTitle &&
        lightboxContent &&
        lightboxLoading &&
        closeButton &&
        prevButton &&
        nextButton;

      return {
        lightbox,
        lightboxImage,
        lightboxTitle,
        lightboxContent,
        lightboxLoading,
        lightboxCounter,
        closeButton,
        prevButton,
        nextButton,
        isValid,
      };
    }

    initialize() {
      this.elements.closeButton.addEventListener("click", this.boundHandlers.close);
      this.elements.prevButton.addEventListener("click", this.boundHandlers.prev);
      this.elements.nextButton.addEventListener("click", this.boundHandlers.next);
      this.elements.lightbox.addEventListener("click", this.boundHandlers.backdropClick);
      this.elements.lightbox.addEventListener("touchstart", this.boundHandlers.touchStart, { passive: true });
      this.elements.lightbox.addEventListener("touchend", this.boundHandlers.touchEnd, { passive: true });
      document.addEventListener("click", this.boundHandlers.documentClick);
      document.addEventListener("keydown", this.boundHandlers.documentKeydown);
    }

    getFocusableElements() {
      const selectors = [
        'a[href]', 'button:not([disabled])', 'input:not([disabled])',
        'select:not([disabled])', 'textarea:not([disabled])',
        '[tabindex]:not([tabindex="-1"])',
      ].join(', ');
      return Array.from(this.elements.lightbox.querySelectorAll(selectors));
    }

    handleFocusTrap(event) {
      if (event.key !== 'Tab') return;
      const focusable = this.getFocusableElements();
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey) {
        if (document.activeElement === first) {
          event.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    }

    getAllPhotos() {
      return Array.from(document.querySelectorAll("[data-photo-trigger]"));
    }

    handleDocumentClick(event) {
      if (this.state.isOpen) return;
      const trigger = event.target.closest("[data-photo-trigger]");
      if (trigger) {
        event.preventDefault();
        this.openLightbox(trigger);
      }
    }

    handleDocumentKeydown(event) {
      if (this.state.isOpen) {
        this.handleLightboxKeydown(event);
      } else if (event.key === "Enter" || event.key === " ") {
        const trigger = event.target.closest("[data-photo-trigger]");
        if (trigger) {
          event.preventDefault();
          this.openLightbox(trigger);
        }
      }
    }

    handleBackdropClick(event) {
      if (event.target === this.elements.lightbox) {
        this.closeLightbox();
      }
    }

    updateNavigationButtons() {
      const allPhotos = this.getAllPhotos();
      const { prevButton, nextButton, lightboxCounter } = this.elements;
      const { currentPhotoIndex } = this.state;

      const showPrev = currentPhotoIndex > 0;
      const hasMoreLoadedPhotos = currentPhotoIndex < allPhotos.length - 1;
      const hasMorePhotosToLoad = window.staticPhotoLoader?.hasMorePhotos?.() ?? false;
      const showNext = hasMoreLoadedPhotos || hasMorePhotosToLoad;

      prevButton.classList.toggle("hidden", !showPrev);
      prevButton.classList.toggle("flex", showPrev);
      nextButton.classList.toggle("hidden", !showNext);
      nextButton.classList.toggle("flex", showNext);

      if (lightboxCounter) {
        const total = hasMorePhotosToLoad
          ? `${allPhotos.length}+`
          : `${allPhotos.length}`;
        lightboxCounter.textContent = `${currentPhotoIndex + 1} / ${total}`;
      }
    }

    loadPhoto(photoElement) {
      const fullImage = photoElement.getAttribute("data-full-image");
      const title = photoElement.getAttribute("data-title");
      const content = photoElement.getAttribute("data-content");

      if (!fullImage || !title) {
        console.warn("[StaticPhotoLightbox] Missing required photo data");
        return;
      }

      const { lightboxTitle, lightboxContent, lightboxLoading, lightboxImage } =
        this.elements;

      lightboxTitle.textContent = title.trim()
        ? (new DOMParser().parseFromString(title, "text/html").body.textContent ?? "")
        : "";

      lightboxContent.textContent = content?.trim()
        ? (new DOMParser().parseFromString(content, "text/html").body.textContent ?? "")
        : "";

      lightboxLoading.classList.remove("hidden");
      lightboxLoading.classList.add("flex");
      lightboxImage.classList.add("opacity-0");

      const img = new Image();

      img.onload = () => {
        lightboxImage.src = img.src;
        lightboxImage.alt = title;
        lightboxLoading.classList.add("hidden");
        lightboxLoading.classList.remove("flex");
        lightboxImage.classList.remove("opacity-0");
        lightboxImage.focus();
      };

      img.onerror = () => {
        console.error("[StaticPhotoLightbox] Failed to load image:", fullImage);
        lightboxLoading.classList.add("hidden");
        lightboxLoading.classList.remove("flex");
        lightboxImage.classList.remove("opacity-0");
        lightboxImage.alt = `Failed to load: ${title}`;
      };

      img.src = fullImage;
      this.updateNavigationButtons();
    }

    openLightbox(trigger) {
      const allPhotos = this.getAllPhotos();
      const index = allPhotos.indexOf(trigger);

      if (index === -1) {
        console.warn("[StaticPhotoLightbox] Photo trigger not found in collection");
        return;
      }

      this.triggerElement = document.activeElement;
      this.state.currentPhotoIndex = index;
      this.state.isOpen = true;

      this.elements.lightbox.classList.remove("opacity-0", "pointer-events-none");
      this.elements.lightbox.setAttribute("aria-hidden", "false");
      document.documentElement.classList.add("lightbox-open");

      this.elements.lightbox.addEventListener("keydown", this.boundHandlers.trapFocus);

      this.loadPhoto(trigger);

      setTimeout(() => {
        this.elements.closeButton.focus();
      }, 100);
    }

    closeLightbox() {
      this.state.isOpen = false;

      this.elements.lightbox.removeEventListener("keydown", this.boundHandlers.trapFocus);
      this.elements.lightbox.classList.add("opacity-0", "pointer-events-none");
      this.elements.lightbox.setAttribute("aria-hidden", "true");
      document.documentElement.classList.remove("lightbox-open");

      this.elements.lightboxImage.src = "";
      this.elements.lightboxImage.classList.add("opacity-0");
      this.elements.lightboxLoading.classList.add("hidden");
      this.elements.lightboxLoading.classList.remove("flex");

      if (this.triggerElement) {
        this.triggerElement.focus();
        this.triggerElement = null;
      }
    }

    goToNextPhoto() {
      const allPhotos = this.getAllPhotos();

      if (this.state.currentPhotoIndex < allPhotos.length - 1) {
        this.state.currentPhotoIndex++;
        this.loadPhoto(allPhotos[this.state.currentPhotoIndex]);
      } else if (window.staticPhotoLoader?.hasMorePhotos?.()) {
        window.staticPhotoLoader.loadMorePhotos().then(() => {
          const updatedPhotos = this.getAllPhotos();
          if (this.state.currentPhotoIndex < updatedPhotos.length - 1) {
            this.state.currentPhotoIndex++;
            this.loadPhoto(updatedPhotos[this.state.currentPhotoIndex]);
          }
        });
      }
    }

    goToPrevPhoto() {
      const allPhotos = this.getAllPhotos();
      if (this.state.currentPhotoIndex > 0) {
        this.state.currentPhotoIndex--;
        this.loadPhoto(allPhotos[this.state.currentPhotoIndex]);
      }
    }

    handleTouchStart(event) {
      const touch = event.changedTouches[0];
      this.touchStartX = touch.clientX;
      this.touchStartY = touch.clientY;
    }

    handleTouchEnd(event) {
      if (!this.state.isOpen) return;
      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - this.touchStartX;
      const deltaY = touch.clientY - this.touchStartY;

      // Require primarily horizontal movement: |deltaX| > |deltaY| and at least 50px
      if (Math.abs(deltaX) < 50 || Math.abs(deltaX) <= Math.abs(deltaY)) return;

      if (deltaX < 0) {
        this.goToNextPhoto();
      } else {
        this.goToPrevPhoto();
      }
    }

    handleLightboxKeydown(event) {
      switch (event.key) {
        case "Escape":
          event.preventDefault();
          this.closeLightbox();
          break;
        case "ArrowLeft":
          event.preventDefault();
          this.goToPrevPhoto();
          break;
        case "ArrowRight":
          event.preventDefault();
          this.goToNextPhoto();
          break;
        case "Home": {
          event.preventDefault();
          const allPhotos = this.getAllPhotos();
          if (allPhotos.length > 0) {
            this.state.currentPhotoIndex = 0;
            this.loadPhoto(allPhotos[0]);
          }
          break;
        }
        case "End": {
          event.preventDefault();
          const allPhotos = this.getAllPhotos();
          if (allPhotos.length > 0) {
            this.state.currentPhotoIndex = allPhotos.length - 1;
            this.loadPhoto(allPhotos[this.state.currentPhotoIndex]);
          }
          break;
        }
      }
    }

    destroy() {
      document.removeEventListener("click", this.boundHandlers.documentClick);
      document.removeEventListener("keydown", this.boundHandlers.documentKeydown);
      if (this.elements.lightbox) {
        this.elements.lightbox.removeEventListener("click", this.boundHandlers.backdropClick);
        this.elements.lightbox.removeEventListener("keydown", this.boundHandlers.trapFocus);
        this.elements.lightbox.removeEventListener("touchstart", this.boundHandlers.touchStart);
        this.elements.lightbox.removeEventListener("touchend", this.boundHandlers.touchEnd);
      }
      if (this.elements.closeButton) {
        this.elements.closeButton.removeEventListener("click", this.boundHandlers.close);
      }
      if (this.elements.prevButton) {
        this.elements.prevButton.removeEventListener("click", this.boundHandlers.prev);
      }
      if (this.elements.nextButton) {
        this.elements.nextButton.removeEventListener("click", this.boundHandlers.next);
      }
    }
  }

  let lightboxInstance = null;

  function initStaticLightbox() {
    if (lightboxInstance) {
      lightboxInstance.destroy();
    }
    const lb = document.getElementById("photo-lightbox");
    if (!lb) return;
    lightboxInstance = new StaticPhotoLightbox();
  }

  document.addEventListener("astro:page-load", initStaticLightbox);
</script>

<style is:global>
  html.lightbox-open {
    overflow: hidden;
  }

  #photo-lightbox {
    background-color: rgba(0, 0, 0, 0.92);
    transition: opacity 200ms ease;
  }

  #lightbox-info {
    background-color: rgba(0, 0, 0, 0.82);
  }

  #photo-lightbox button:focus-visible {
    outline: 1px solid rgba(255, 255, 255, 0.6);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    #photo-lightbox,
    #lightbox-image {
      transition: none;
    }
  }
</style>
