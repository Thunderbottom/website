---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import WritingList from "@components/WritingList.astro";
import Link from "@components/Link.astro";
import { WRITING_HOME } from "@lib/config";
import { getWriting } from "@lib/writing";

const recent = (await getWriting()).slice(0, 3);
---

<PageLayout title="Page Not Found" description="This page doesn’t exist.">
  <Container class="stack stack-lg">
    <section class="stack stack-md">
      <h1 class="title">Nothing at this address.</h1>
      <div class="prose">
        <p>
          The page you followed a link to doesn’t exist, or it has moved. <Link
            href="/"
            underline>Head back home</Link
          >, or pick up something recent.
        </p>
      </div>
    </section>

    {
      WRITING_HOME && recent.length > 0 && (
        <section>
          <div class="section-head">
            <h2>Writing</h2>
            <Link href={WRITING_HOME}>
              All writing <span class="arrow">→</span>
            </Link>
          </div>
          <div class="log">
            <WritingList items={recent} byYear={false} compact showKind />
          </div>
        </section>
      )
    }
  </Container>
</PageLayout>
