---
import { getCollection, type CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PageContainer from "@components/PageContainer.astro";
import BackToPrev from "@components/BackToPrev.astro";
import { formatDate } from "@lib/config";
import { parseTags, tagToSlug, sortByDateDesc } from "@lib/utils";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);

  const tagMap = new Map<
    string,
    { displayTag: string; posts: CollectionEntry<"blog">[] }
  >();
  for (const post of allPosts) {
    for (const tag of parseTags(post.data.tags)) {
      const slug = tagToSlug(tag);
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { displayTag: tag, posts: [] });
      }
      tagMap.get(slug)!.posts.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, { displayTag, posts }]) => ({
    params: { tag: slug },
    props: { displayTag, posts: sortByDateDesc(posts) },
  }));
}

const { tag } = Astro.params;
const { displayTag, posts: allPosts } = Astro.props;
---

<PageLayout
  title={`Posts tagged "${displayTag}"`}
  description={`All blog posts tagged with ${displayTag}`}
  currentPath={`/tags/${tag}/`}
>
  <PageContainer spacing="md">
    <div>
      <BackToPrev href="/tags">all tags</BackToPrev>
    </div>

    <div>
      <h1 class="heading-2xl">{displayTag}</h1>
      <p
        class="text-text-muted dark:text-text-muted-dark mt-2 font-mono text-xs"
      >
        {allPosts.length}
        {allPosts.length === 1 ? "post" : "posts"}
      </p>
    </div>

    {
      allPosts.length > 0 ? (
        <div class="border-border dark:border-border-dark border-t">
          {allPosts.map((post) => (
            <a href={`/blog/${post.id}/`} class="post-item group">
              <span class="post-item-title">{post.data.title}</span>
              <time
                class="post-item-date"
                datetime={new Date(post.data.date).toISOString()}
              >
                {formatDate(new Date(post.data.date), "%b %Y")}
              </time>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-text-secondary dark:text-text-secondary-dark">
          No posts found.
        </p>
      )
    }
  </PageContainer>
</PageLayout>
