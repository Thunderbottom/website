---
export const prerender = true;

import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PageContainer from "@components/PageContainer.astro";
import PageHeader from "@components/PageHeader.astro";
import { parseTags, tagToSlug } from "@lib/utils";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

const tagMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of parseTags(post.data.tags)) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}

const sortedTags = Array.from(tagMap.entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0]);
});
---

<PageLayout title="Tags" description="Browse posts by tag" currentPath="/tags/">
  <PageContainer spacing="md">
    <PageHeader title="Tags" size="lg" />

    {
      sortedTags.length > 0 ? (
        <div class="flex flex-wrap gap-2">
          {sortedTags.map(([tag, count]) => (
            <a
              href={`/tags/${tagToSlug(tag)}/`}
              class="group border-border dark:border-border-dark text-text-secondary dark:text-text-secondary-dark hover:bg-text-primary hover:text-background dark:hover:bg-text-primary-dark dark:hover:text-background-dark inline-flex min-h-[44px] items-center gap-2 border px-3 font-mono text-xs transition-[background-color,color,border-color] duration-150"
            >
              {tag}
              <span class="text-text-muted dark:text-text-muted-dark group-hover:text-background dark:group-hover:text-background-dark transition-colors duration-150">
                {count}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-text-secondary dark:text-text-secondary-dark">
          No tags found.
        </p>
      )
    }
  </PageContainer>
</PageLayout>
