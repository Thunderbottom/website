---
import { getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import BackToPrev from "@components/BackToPrev.astro";
import Message from "@components/Message.astro";
import Sidenote from "@components/Sidenote.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Tag from "@components/Tag.astro";
import { parseTags, tagToSlug } from "@lib/utils";
import Link from "@components/Link.astro";
import { SITE } from "@lib/config";

export const prerender = true;

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog", ({ data }) => {
    return !data.draft;
  });

  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const readingTime = remarkPluginFrontmatter?.minutesRead || "1 min read";
const tags = parseTags(entry.data.tags);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = entry.data.toc !== false && tocHeadings.length >= 2;

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description || entry.data.summary,
  datePublished: new Date(entry.data.date).toISOString(),
  ...(entry.data.last_modified_at && {
    dateModified: new Date(entry.data.last_modified_at).toISOString(),
  }),
  url: `${SITE.URL}/blog/${entry.id}/`,
  author: {
    "@type": "Person",
    "@id": `${SITE.URL}/#person`,
    name: SITE.NAME,
    url: SITE.URL,
  },
  publisher: {
    "@type": "Person",
    "@id": `${SITE.URL}/#person`,
    name: SITE.NAME,
    url: SITE.URL,
  },
};

const components = {
  Message,
  Sidenote,
};
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description || entry.data.summary}
  currentPath={`/blog/${entry.id}/`}
  ogType="article"
  jsonLd={jsonLd}
>
  <div
    class="mx-auto max-w-[42rem] px-4 sm:px-6 xl:grid xl:max-w-none xl:grid-cols-[minmax(0,1fr)_42rem_minmax(0,1fr)] xl:px-0"
  >
    {
      hasToc ? (
        <aside class="blog-toc-aside hidden xl:block">
          <div class="blog-toc-sticky">
            <TableOfContents headings={tocHeadings} defaultOpen={true} />
          </div>
        </aside>
      ) : (
        <div class="hidden xl:block" aria-hidden="true" />
      )
    }

    <div class="space-y-8 xl:px-6">
      <div>
        <BackToPrev href="/blog">back to blog</BackToPrev>
      </div>

      <div class="space-y-4">
        <div
          class="text-text-secondary dark:text-text-secondary-dark flex items-center gap-2 font-mono text-xs"
        >
          <FormattedDate date={entry.data.date} format="%B %d, %Y" />
          <span>•</span>
          <span>{readingTime}</span>
          {
            entry.data.last_modified_at && (
              <>
                <span>•</span>
                <span>
                  Updated:{" "}
                  <FormattedDate
                    date={entry.data.last_modified_at}
                    format="%B %d, %Y"
                  />
                </span>
              </>
            )
          }
        </div>

        <h1
          class="post-title font-display text-text-primary dark:text-text-primary-dark font-bold"
        >
          {entry.data.title}
        </h1>

        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <a
                  href={`/tags/${tagToSlug(tag)}/`}
                  class="inline-flex min-h-[44px] items-center"
                >
                  <Tag text={tag} />
                </a>
              ))}
            </div>
          )
        }
      </div>

      {
        hasToc && (
          <div class="border-border dark:border-border-dark border p-4 xl:hidden">
            <TableOfContents headings={tocHeadings} defaultOpen={false} />
          </div>
        )
      }

      <article class="max-w-none">
        <Content components={components} />
      </article>

      <div
        class="border-border dark:border-border-dark border-t pt-8 text-center"
      >
        <p
          class="text-text-secondary dark:text-text-secondary-dark text-base italic"
        >
          Got any questions or comments? <Link
            href={`mailto:${SITE.EMAIL}`}
            underline>Drop me an email.</Link
          >
        </p>
      </div>
    </div>

    <div class="hidden xl:block" aria-hidden="true"></div>
  </div>
</PageLayout>
