---
export const prerender = true;

import PageLayout from "@layouts/PageLayout.astro";
import PageContainer from "@components/PageContainer.astro";
import { NOW, NOW_DATA } from "@lib/config";
---

<PageLayout title={NOW.TITLE} description={NOW.DESCRIPTION} currentPath="/now/">
  <PageContainer spacing="md">
    <div>
      <h1 class="heading-2xl">{NOW.TITLE}</h1>
      <p
        class="text-text-muted dark:text-text-muted-dark mt-3 font-mono text-xs leading-relaxed italic"
      >
        "Here lieth a liste, certes in no certaine ordre or prioritie, of that
        which I might be about in this presente houre"
      </p>
    </div>

    <div class="space-y-8">
      {
        NOW_DATA.map((section) => (
          <div>
            <div class="border-border dark:border-border-dark mb-3 flex items-center border-b pb-1">
              <h2 class="text-text-muted dark:text-text-muted-dark font-mono text-xs font-normal">
                {section.title.toLowerCase()}
              </h2>
            </div>
            {section.items.length > 0 ? (
              <ul class="space-y-2">
                {section.items.map((item) => (
                  <li class="text-text-secondary dark:text-text-secondary-dark flex items-baseline gap-3 text-sm leading-relaxed">
                    <span class="text-text-muted dark:text-text-muted-dark flex-shrink-0">
                      →
                    </span>
                    <span set:html={item} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-text-muted dark:text-text-muted-dark text-sm italic">
                Nothing at the moment.
              </p>
            )}
          </div>
        ))
      }
    </div>
  </PageContainer>
</PageLayout>
