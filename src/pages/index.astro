---
import { getEntry, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import WritingList from "@components/WritingList.astro";
import ProjectCard from "@components/ProjectCard.astro";
import InlineText from "@components/InlineText.astro";
import MarkdownLink from "@components/MarkdownLink.astro";
import Link from "@components/Link.astro";
import { SITE, SOCIALS, WRITING_HOME, formatDate } from "@lib/config";
import { FEATURES } from "@site";
import { getProjects } from "@lib/projects";
import { getWriting } from "@lib/writing";

// The introduction is src/content/pages/home.md.
const home = await getEntry("pages", "home");
const { Content } = home ? await render(home) : { Content: null };

// The featured slot is always the latest long-form post; the rows under it are
// the newest writing of any kind (so a short note can show up here too).
const writing = await getWriting();
const featuredItem = writing.find((item) => item.kind === "post");
const featured = featuredItem?.entry;
const rest = writing
  .filter((item) => item !== featuredItem)
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE - (featured ? 1 : 0));
const writingLink =
  WRITING_HOME === "/writing"
    ? "All Writing"
    : WRITING_HOME === "/notes"
      ? "All Notes"
      : "All Posts";

const recentProjects = (await getProjects()).slice(
  0,
  SITE.NUM_PROJECTS_ON_HOMEPAGE,
);

// "Now": the first item of each section that has one.
const now = FEATURES.now ? (await getEntry("now", "now"))?.data : undefined;
const currently = (now?.sections ?? [])
  .filter((section) => section.items.length > 0)
  .map((section) => ({
    label: section.title.toLowerCase(),
    text: section.items[0],
  }));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.URL}/#website`,
      url: SITE.URL,
      name: SITE.NAME,
      description: SITE.DESCRIPTION,
    },
    {
      "@type": "Person",
      "@id": `${SITE.URL}/#person`,
      name: SITE.NAME,
      url: SITE.URL,
      email: SITE.EMAIL,
      sameAs: SOCIALS.map((s) => s.href).filter(
        (href) => !href.startsWith("mailto:"),
      ),
    },
  ],
};
---

<PageLayout jsonLd={jsonLd}>
  <Container class="stack stack-lg">
    <section class="stack stack-md">
      <h1 class="title">{SITE.NAME}</h1>

      {
        Content && (
          <div class="prose">
            <Content components={{ a: MarkdownLink }} />
          </div>
        )
      }

      {
        home?.data.quote && (
          <p class="quip" lang={home.data.quoteLang}>
            “{home.data.quote}”
          </p>
        )
      }
    </section>

    {
      currently.length > 0 && (
        <section>
          <div class="section-head">
            <h2>Now</h2>
            <Link href="/now">
              Now page <span class="arrow">→</span>
            </Link>
          </div>
          <dl class="currently">
            {currently.map((entry) => (
              <>
                <dt>{entry.label}</dt>
                <dd>
                  <InlineText text={entry.text} />
                </dd>
              </>
            ))}
          </dl>
        </section>
      )
    }

    {
      WRITING_HOME && writing.length > 0 && (
        <section>
          <div class="section-head">
            <h2>Writing</h2>
            <Link href={WRITING_HOME}>
              <span>{writingLink}</span> <span class="arrow">→</span>
            </Link>
          </div>
          {featured && (
            <a href={`/blog/${featured.id}/`} class="featured">
              <span class="featured-meta">
                <time
                  class="log-date"
                  datetime={new Date(featured.data.date).toISOString()}
                >
                  {formatDate(featured.data.date, "%Y-%m-%d")}
                </time>
                <span class="pill">latest</span>
              </span>
              <span class="featured-title">{featured.data.title}</span>
              {(featured.data.description || featured.data.summary) && (
                <span class="log-desc">
                  {featured.data.description || featured.data.summary}
                </span>
              )}
            </a>
          )}
          <div class="log">
            <WritingList items={rest} byYear={false} compact showKind />
          </div>
        </section>
      )
    }

    {
      recentProjects.length > 0 && (
        <section>
          <div class="section-head">
            <h2>Projects</h2>
            <Link href="/projects">
              All Projects <span class="arrow">→</span>
            </Link>
          </div>
          <div class="log">
            {recentProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      )
    }
  </Container>
</PageLayout>
